{
  "appId": "com.biblestudyjourney.app",
  "appName": "Bible Study Journey",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#283A50",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "auto"
  }
}
