{
  "name": "bible-study-journey",
  "displayName": "Bible Study Journey",
  "version": "1.0.0",
  "description": "App de estudo bíblico com contexto: leitura, devocional diário e trilhas de estudo.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "cross-env NODE_ENV=development node backend/server.js",
    "prod": "cross-env NODE_ENV=production node backend/server.js",
    "build:bible": "node scripts/build-bible-data.js"
  },
  "keywords": [
    "biblia",
    "estudo-biblico",
    "devocional",
    "capacitor"
  ],
  "author": "Guilherme Braga",
  "license": "UNLICENSED",
  "devDependencies": {
    "cordova-android": "^14.0.1",
    "cordova-browser": "^7.0.0"
  },
  "cordova": {
    "platforms": [
      "browser",
      "android"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/device": "^7.0.1",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "localforage": "^1.10.0",
    "node-fetch": "^2.7.0",
